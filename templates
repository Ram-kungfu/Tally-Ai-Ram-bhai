<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ram Bhai Tally Pro Ledger v3.0</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        body { background: linear-gradient(135deg, #0f0c29 0%, #302b63 50%, #24243e 100%); min-height: 100vh; font-family: 'Segoe UI', sans-serif; color: #fff; padding-bottom: 50px; }
        .main-card { background: rgba(255, 255, 255, 0.98); border-radius: 20px; box-shadow: 0 15px 35px rgba(0,0,0,0.5); overflow: hidden; margin-top: 10px; color: #333; border: 1px solid rgba(255,255,255,0.1); }
        .header-section { background: #1a237e; padding: 15px; color: white; text-align: center; }
        
        /* Dashboard Styling */
        .tally-dashboard { background: rgba(0,0,0,0.8); border-radius: 20px; padding: 20px; margin-top: 20px; border: 1px solid #444; }
        .stat-box { background: rgba(255,255,255,0.05); padding: 10px; border-radius: 12px; margin-bottom: 10px; border-left: 4px solid #fff; }
        .stat-label { font-size: 10px; color: #bbb; text-transform: uppercase; letter-spacing: 1px; }
        .stat-value { font-size: 16px; font-weight: bold; display: block; }
        
        .form-label { font-size: 13px; font-weight: 600; color: #555; margin-bottom: 4px; }
        .form-control, .form-select { border-radius: 8px; border: 1px solid #ddd; padding: 8px; font-size: 14px; }
        
        .ai-btn-group { display: flex; gap: 10px; margin-bottom: 15px; }
        .ai-btn { flex: 1; border: none; padding: 12px; border-radius: 10px; font-weight: bold; color: white; transition: 0.3s; }
        .btn-cam { background: #2e7d32; }
        .btn-gal { background: #ef6c00; }
        .btn-save { background: #1a237e; color: white; width: 100%; padding: 12px; border-radius: 10px; font-weight: bold; border: none; margin-top: 10px; font-size: 16px; }
        
        .loader { display: none; text-align: center; padding: 20px; }
    </style>
</head>
<body>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            
            <div class="text-center py-3">
                <h2 style="font-weight: 800; letter-spacing: 1px;">राम भाई कुंग फू मास्टर</h2>
                <span class="badge bg-warning text-dark">PRO TALLY LEDGER v3.0</span>
            </div>

            <div class="main-card shadow-lg">
                <div class="header-section">
                    <h5 class="mb-0"><i class="fas fa-file-invoice-dollar"></i> डिजिटल वाउचर एंट्री</h5>
                </div>

                <div class="card-body p-4">
                    <div class="ai-btn-group">
                        <button onclick="openCamera()" class="ai-btn btn-cam"><i class="fas fa-camera"></i> कैमरा</button>
                        <button onclick="openGallery()" class="ai-btn btn-gal"><i class="fas fa-images"></i> गैलरी</button>
                    </div>
                    
                    <input type="file" id="cameraInput" accept="image/*" capture="camera" style="display: none;">
                    <input type="file" id="galleryInput" accept="image/*" style="display: none;">

                    <div id="loader" class="loader">
                        <div class="spinner-border text-primary"></div>
                        <p class="mt-2 fw-bold text-primary">Tally AI प्रोसेसिंग चालू है...</p>
                    </div>

                    <div id="formContent">
                        <div class="mb-3">
                            <label class="form-label">कंपनी/पार्टी का नाम</label>
                            <input type="text" id="company_name" class="form-control" list="company_list" placeholder="नाम लिखें...">
                            <datalist id="company_list">
                                <option value="My Indian Karigar">
                                <option value="Upchar Hub">
                                <option value="Gyan Niwas">
                            </datalist>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label">आइटम का नाम</label>
                                <input type="text" id="item_name" class="form-control" placeholder="उदा: CCTV">
                            </div>
                            <div class="col-3">
                                <label class="form-label">मात्रा</label>
                                <input type="number" id="qty" class="form-control" value="1">
                            </div>
                            <div class="col-3">
                                <label class="form-label">यूनिट</label>
                                <select id="unit" class="form-select">
                                    <option value="Pcs">Pcs</option>
                                    <option value="Kg">Kg</option>
                                    <option value="Pkt">Pkt</option>
                                    <option value="Bndl">Bndl</option>
                                    <option value="Ltr">Ltr</option>
                                </select>
                            </div>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label text-danger">खरीद दर (Buy Rate)</label>
                                <input type="number" id="buy_price" class="form-control" placeholder="₹ 0">
                            </div>
                            <div class="col-6">
                                <label class="form-label text-success">बिक्री दर (Sell Rate)</label>
                                <input type="number" id="sell_price" class="form-control" placeholder="₹ 0">
                            </div>
                        </div>

                        <div class="row g-2 mb-4">
                            <div class="col-7">
                                <label class="form-label text-primary">भुगतान किया (Paid)</label>
                                <input type="number" id="paid_amount" class="form-control" value="0">
                            </div>
                            <div class="col-5">
                                <label class="form-label">GST %</label>
                                <select id="gst_rate" class="form-select">
                                    <option value="0">0%</option>
                                    <option value="5">5%</option>
                                    <option value="12">12%</option>
                                    <option value="18">18%</option>
                                </select>
                            </div>
                        </div>

                        <button onclick="saveData()" class="btn btn-save">
                            <i class="fas fa-check-circle"></i> वाउचर सेव और स्टॉक अपडेट करें
                        </button>
                    </div>
                </div>
            </div>

            <div class="tally-dashboard shadow-lg">
                <h6 class="text-center mb-4 text-warning"><i class="fas fa-chart-line"></i> बिजनेस बैलेंस शीट (Live)</h6>
                <div class="row g-2">
                    <div class="col-6">
                        <div class="stat-box" style="border-color: #0dcaf0;">
                            <span class="stat-label">कुल बिक्री</span>
                            <span id="dash_sales" class="stat-value text-info">₹0</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="stat-box" style="border-color: #ffc107;">
                            <span class="stat-label">कुल निवेश</span>
                            <span id="dash_invest" class="stat-value text-warning">₹0</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="stat-box" style="border-color: #f8f9fa;">
                            <span class="stat-label">कुल GST कलेक्शन</span>
                            <span id="dash_tax" class="stat-value text-light">₹0</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="stat-box" style="border-color: #198754;">
                            <span class="stat-label">नेट प्रॉफिट</span>
                            <span id="dash_profit" class="stat-value text-success">₹0</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="stat-box" style="border-color: #6f42c1;">
                            <span class="stat-label">बचा हुआ स्टॉक</span>
                            <span id="dash_stock" class="stat-value text-white">0 Item</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="stat-box" style="border-color: #dc3545;">
                            <span class="stat-label">बाकी उधारी</span>
                            <span id="dash_pending" class="stat-value text-danger">₹0</span>
                        </div>
                    </div>
                </div>
                <button onclick="loadDashboard()" class="btn btn-sm btn-outline-light w-100 mt-3 opacity-50">
                    <i class="fas fa-sync"></i> लाइव डेटा रिफ्रेश
                </button>
            </div>

            <footer class="text-center mt-4 text-white-50">
                <small>Developed for Ram Bhai & Associated Companies <br> © 2026 AI Financial Engine</small>
            </footer>
        </div>
    </div>
</div>

<script>
function openCamera() { document.getElementById('cameraInput').click(); }
function openGallery() { document.getElementById('galleryInput').click(); }

// --- लाइव डैशबोर्ड अपडेट ---
async function loadDashboard() {
    try {
        const res = await fetch('/dashboard_data');
        const d = await res.json();
        
        document.getElementById('dash_invest').innerText = "₹" + (d.total_invest || 0);
        document.getElementById('dash_sales').innerText = "₹" + (d.total_sales || 0);
        document.getElementById('dash_profit').innerText = "₹" + (d.total_profit || 0);
        document.getElementById('dash_pending').innerText = "₹" + (d.total_pending || 0);
        document.getElementById('dash_tax').innerText = "₹" + (d.total_gst || 0);
        document.getElementById('dash_stock').innerText = (d.total_stock || 0) + " Qty";
    } catch(e) { console.log("डेटा रिफ्रेश फेल"); }
}

// --- डेटा सेविंग ---
async function saveData() {
    const data = {
        company: document.getElementById('company_name').value,
        item: document.getElementById('item_name').value,
        quantity: document.getElementById('qty').value,
        unit: document.getElementById('unit').value,
        buy: document.getElementById('buy_price').value,
        sell: document.getElementById('sell_price').value,
        paid: document.getElementById('paid_amount').value,
        gst: document.getElementById('gst_rate').value
    };

    if(!data.company || !data.item || !data.buy) { 
        alert("कृपया पार्टी, आइटम और खरीद दाम जरूर भरें!"); 
        return; 
    }

    try {
        const response = await fetch('/save', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify(data)
        });
        
        const result = await response.json();
        if(result.status === "success") {
            alert("✅ एंट्री और स्टॉक अपडेट सफल!");
            // फॉर्म साफ़ करना
            document.getElementById('item_name').value = "";
            document.getElementById('qty').value = "1";
            document.getElementById('buy_price').value = "";
            document.getElementById('sell_price').value = "";
            document.getElementById('paid_amount').value = "0";
            loadDashboard();
        }
    } catch(e) { alert("सर्वर से कनेक्शन नहीं हो पाया!"); }
}

// --- AI स्कैनिंग ---
async function handleImageUpload(e) {
    const file = e.target.files[0];
    const company = document.getElementById('company_name').value || "AI Scanned Party";
    if(!file) return;

    document.getElementById('loader').style.display = 'block';
    document.getElementById('formContent').style.display = 'none';

    let formData = new FormData();
    formData.append('image', file);
    formData.append('company', company);

    try {
        const response = await fetch('/scan_bill', { method: 'POST', body: formData });
        const data = await response.json();
        if(data.status === "success") {
            alert("✅ AI ने बिल रीड कर लिया है!");
            loadDashboard();
        }
    } catch (err) { alert("AI प्रोसेसिंग में त्रुटि!"); }
    finally {
        document.getElementById('loader').style.display = 'none';
        document.getElementById('formContent').style.display = 'block';
    }
}

document.getElementById('cameraInput').onchange = handleImageUpload;
document.getElementById('galleryInput').onchange = handleImageUpload;

// ऑटो रिफ्रेश सेटिंग
window.onload = loadDashboard;
setInterval(loadDashboard, 30000); 
</script>

</body>
</html>

